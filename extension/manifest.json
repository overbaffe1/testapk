{
  "manifest_version": 3,
  "key": "",
  "name": "qWDTT — туннель в браузер",
  "short_name": "qWDTT",
  "version": "1.2.0",
  "description": "Пускает трафик Chrome через ваш qWDTT/WDTT-туннель (VK TURN + WireGuard) через локальный SOCKS5.",
  "minimum_chrome_version": "116",
  "permissions": [
    "proxy",
    "storage",
    "alarms",
    "nativeMessaging",
    "webRequest",
    "webRequestAuthProvider"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "qWDTT — туннель в браузер",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
